-s dir
-n mysql_looper
--url="https://github.com/wreiske/mysql_looper" 
--description="Command-line tools to execute MySQL queries in a loop and measure execution time."
--license="MIT"
--vendor="Medical Informatics Engineering, Inc."
--maintainer="Will Reiske <wreiske@mieweb.com>"
--architecture="amd64"
--deb-build-depends="libmysqlclient-dev"
--depends="libmariadb3 | libmysqlclient21"
--verbose

build/mysql_looper=/usr/bin/mysql_looper
build/mysql_looperd=/usr/bin/mysql_looperd